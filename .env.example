# The organizer supplies the temporary shared configuration privately.
# Copy this file to .env when setting up your own configuration.
# Endpoint: the supplied Azure resource URL; its hostname is used unchanged.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Use the reasoning effort supplied by the organizer.
# Keep this setting identical between baseline and optimized measurements.
AZURE_OPENAI_REASONING_EFFORT=minimal
